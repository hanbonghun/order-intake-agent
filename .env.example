DATABASE_URL=postgresql://intake:intake@localhost:5432/intake
# DB_PORT=5432            # docker compose가 호스트에 여는 포트

# --- 로컬 모델 (기본값) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_MODEL_SMALL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI로 바꿀 때 ---
# LLM_PROVIDER=openai
# LLM_MODEL=<모델명>
# LLM_MODEL_SMALL=<모델명>
# OPENAI_API_KEY=
# 추론 계열 모델이 temperature 변경을 거부하면 아래 줄을 주석 해제 (None = 제공사 기본값)
# LLM_TEMPERATURE=
# 비용 집계용 단가: OpenAI 가격표의 USD / 100만 토큰
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# LANGSMITH_API_KEY=
