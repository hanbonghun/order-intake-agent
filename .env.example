DATABASE_URL=postgresql://intake:intake@localhost:5432/intake
# DB_PORT=5432            # docker compose가 호스트에 여는 포트

# --- 로컬 모델 (기본값) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_MODEL_SMALL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI로 바꿀 때 ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4-mini-2026-03-17
# LLM_MODEL_SMALL=gpt-5.4-nano-2026-03-17
# OPENAI_API_KEY=
# 추론 계열 모델이 temperature 변경을 거부하면 아래 줄을 주석 해제 (None = 제공사 기본값)
# LLM_TEMPERATURE=
# 비용 집계용 단가: OpenAI 가격표의 USD / 100만 토큰 (2026-10 기준, 모델 문서 페이지)
# LLM_PRICE_INPUT_PER_MTOK=0.75
# LLM_PRICE_OUTPUT_PER_MTOK=4.50
# LLM_SMALL_PRICE_INPUT_PER_MTOK=0.20
# LLM_SMALL_PRICE_OUTPUT_PER_MTOK=1.25

# --- LangSmith 추적 (선택) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=order-intake-agent

# --- 실제 메일 연동 (Gmail IMAP 수신 + SMTP 발신) ---
# Google 계정 2단계 인증을 켜고 "앱 비밀번호"를 발급받아 넣는다 (계정 비밀번호 아님)
# MAIL_ADDRESS=your-test-account@gmail.com
# MAIL_APP_PASSWORD=
# MAIL_SEND_ENABLED=false            # true여야 실제 발신
# MAIL_SEND_ALLOWLIST=               # 쉼표 구분, 여기 있는 주소로만 발신
# MAIL_POLL_SECONDS=30
